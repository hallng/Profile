   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Symmetric Numerical Three-Dimensional Matching: Intractability and Inapproximability</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li xml:lang="x-default">numerical three-dimensional matching</rdf:li>
     <rdf:li xml:lang="x-default">symmetric item classes</rdf:li>
     <rdf:li xml:lang="x-default">strong NP-completeness</rdf:li>
     <rdf:li xml:lang="x-default">unary encoding</rdf:li>
     <rdf:li xml:lang="x-default">approximation gap</rdf:li>
     <rdf:li xml:lang="x-default">L-reduction</rdf:li>
     <rdf:li xml:lang="x-default">APX-hardness</rdf:li>
    </rdf:Bag>
   </dc:subject>
